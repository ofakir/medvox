# Copie ce fichier en ".env" (il est ignoré par Git) et remplis tes valeurs.

# Clé API Groq (https://console.groq.com/keys) — utilisée pour générer les documents
GROQ_API_KEY=

# Optionnel : clé Gemini (seulement pour check_models.php / test_gemini_key.php)
GEMINI_API_KEY=

# Optionnel : MySQL. Si DB_HOST est vide, MedVox utilise SQLite (data/medvox.sqlite).
DB_HOST=
DB_PORT=3306
DB_NAME=cabinet_medical
DB_USER=root
DB_PASSWORD=
